PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=rbtchat-local-development-secret
MONGODB_URI=mongodb://127.0.0.1:27017/RBTChatLocal
ALLOW_DEV_OTP_FALLBACK=true

