# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TEMPERATURE=0.6
AI_MAX_HISTORY=20
PYTHON_EXECUTABLE=python
